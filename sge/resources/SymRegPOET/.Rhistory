library(stringr)
library(lubridate)
library(longitudinalData)
setwd("/home/aidan/Dropbox/MSU/Research/Brianna Project/")
path <- "Data/EPG 3F Training Data.xlsx"
sheetnames <- excel_sheets(path)
sheetnames
mylist <- lapply(sheetnames, function(x)
read_excel(path,x, col_names = TRUE))
names(mylist) <- sheetnames
#use Map to bind all the elements of the list into a dataframe
my_list <- Map(cbind, mylist, Cluster = names(mylist))
df <- do.call("bind_rows", my_list)
df = df[,!(names(df) %in% "Cluster")]
df$Time = as.POSIXct((str_sub(df$Time,-5,-1)),format="%M:%S")
for (i in 1:nrow(df)){
df$Mean_Val[i] = mean(as.numeric(df[i,6:61]), na.rm=TRUE)
df$Median_Val[i] = median(as.numeric(df[i,6:61]), na.rm=TRUE)
df$Max_Val[i] = max(as.numeric(df[i,6:61]), na.rm=TRUE)
df$Min_Val[i] = min(as.numeric(df[i,6:61]), na.rm=TRUE)
df$TimeStep[i] = as.numeric(difftime(df$Time[i], df$Time[1], units = "secs"))
}
df$Condition[df$Condition == "NS"] = "No Stimulus"
MeanRes = aggregate(as.numeric(df$Mean_Val), by = list(df$Construct, df$Condition, df$TimeStep), FUN = mean)
MeanRes$Group.1 = as.factor(MeanRes$Group.1)
MeanRes$Group.2 = as.factor(MeanRes$Group.2)
MedianRes = aggregate(as.numeric(df$Median_Val), by = list(df$Construct, df$Condition, df$TimeStep), FUN = median)
MedianRes$Group.1 = as.factor(MedianRes$Group.1)
MedianRes$Group.2 = as.factor(MedianRes$Group.2)
constructs = levels(MeanRes$Group.1)
DistanceMat = data.frame(matrix(ncol=9, nrow = 11))
colnames(DistanceMat) <- c("Construct", "FrechetSumMeanSham", "FrechetMaxMeanSham", "FrechetSumMedianSham", "FrechetMaxMedianSham", "FrechetSumMeanNoStimulus", "FrechetMaxMeanNoStimulus", "FrechetSumMedianNoStimulus", "FrechetMaxMedianNoStimulus" )
for (i in 1:length(constructs)){
a = constructs[i]
myMeanRes = MeanRes[MeanRes$Group.1 == a & MeanRes$Group.3 < 1410,]
myMedianRes = MedianRes[MedianRes$Group.1 == a & MedianRes$Group.3 < 1410,]
FrechetSumMeanSham =  distFrechet(myMeanRes$Group.3[myMeanRes$Group.2 == "Active"], myMeanRes$x[myMeanRes$Group.2 == "Active"], myMeanRes$Group.3[myMeanRes$Group.2 == "Sham"], myMeanRes$x[myMeanRes$Group.2 == "Sham"], FrechetSumOrMax="sum")
FrechetMaxMeanSham =  distFrechet(myMeanRes$Group.3[myMeanRes$Group.2 == "Active"], myMeanRes$x[myMeanRes$Group.2 == "Active"], myMeanRes$Group.3[myMeanRes$Group.2 == "Sham"], myMeanRes$x[myMeanRes$Group.2 == "Sham"], FrechetSumOrMax="max")
FrechetSumMedianSham =  distFrechet(myMedianRes$Group.3[myMedianRes$Group.2 == "Active"], myMedianRes$x[myMedianRes$Group.2 == "Active"], myMedianRes$Group.3[myMedianRes$Group.2 == "Sham"], myMedianRes$x[myMedianRes$Group.2 == "Sham"], FrechetSumOrMax="sum")
FrechetMaxMedianSham =  distFrechet(myMedianRes$Group.3[myMedianRes$Group.2 == "Active"], myMedianRes$x[myMedianRes$Group.2 == "Active"], myMedianRes$Group.3[myMedianRes$Group.2 == "Sham"], myMedianRes$x[myMedianRes$Group.2 == "Sham"], FrechetSumOrMax="max")
FrechetSumMeanNoStimulus =  distFrechet(myMeanRes$Group.3[myMeanRes$Group.2 == "Active"], myMeanRes$x[myMeanRes$Group.2 == "Active"], myMeanRes$Group.3[myMeanRes$Group.2 == "No Stimulus"], myMeanRes$x[myMeanRes$Group.2 == "No Stimulus"], FrechetSumOrMax="sum")
FrechetMaxMeanNoStimulus =  distFrechet(myMeanRes$Group.3[myMeanRes$Group.2 == "Active"], myMeanRes$x[myMeanRes$Group.2 == "Active"], myMeanRes$Group.3[myMeanRes$Group.2 == "No Stimulus"], myMeanRes$x[myMeanRes$Group.2 == "No Stimulus"], FrechetSumOrMax="max")
FrechetSumMedianNoStimulus =  distFrechet(myMedianRes$Group.3[myMedianRes$Group.2 == "Active"], myMedianRes$x[myMedianRes$Group.2 == "Active"], myMedianRes$Group.3[myMedianRes$Group.2 == "No Stimulus"], myMedianRes$x[myMedianRes$Group.2 == "No Stimulus"], FrechetSumOrMax="sum")
FrechetMaxMedianNoStimulus =  distFrechet(myMedianRes$Group.3[myMedianRes$Group.2 == "Active"], myMedianRes$x[myMedianRes$Group.2 == "Active"], myMedianRes$Group.3[myMedianRes$Group.2 == "No Stimulus"], myMedianRes$x[myMedianRes$Group.2 == "No Stimulus"], FrechetSumOrMax="max")
DistanceMat$Construct[i] = a
DistanceMat$FrechetSumMeanSham[i] = FrechetSumMeanSham
DistanceMat$FrechetMaxMeanSham[i] = FrechetMaxMeanSham
DistanceMat$FrechetSumMedianSham[i] = FrechetSumMedianSham
DistanceMat$FrechetMaxMedianSham[i] = FrechetMaxMedianSham
DistanceMat$FrechetSumMeanNoStimulus[i] = FrechetSumMeanNoStimulus
DistanceMat$FrechetMaxMeanNoStimulus[i] = FrechetMaxMeanNoStimulus
DistanceMat$FrechetSumMedianNoStimulus[i] = FrechetSumMedianNoStimulus
DistanceMat$FrechetMaxMedianNoStimulus[i] = FrechetMaxMedianNoStimulus
}
#Separting by group
