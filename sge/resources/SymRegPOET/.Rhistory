plot(BNCR$Group.3, BNCR$x, col=BNCR$Group.2, pch = as.numeric(BNCR$Group.2), xlab = "Time", ylab = "Score", main = "BNCR")
legend("bottomleft", legend=c(levels(BNCR$Group.2)),
col=c(1:3), pch=c(1:3), cex=1)
plot(M.E$Group.3, M.E$x, col=M.E$Group.2, pch = as.numeric(M.E$Group.2), xlab = "Time", ylab = "Score", main = "M.E")
legend("bottomleft", legend=c(levels(M.E$Group.2)),
col=c(1:3), pch=c(1:3), cex=1)
mydata = c(B.G, EPG)
test = B.G[B.G$Group.2 == "No Stimulus",]
table(test$Group.3)
table(test$Group.2)
exponential.model <- lm(log(x)~ Group.3, data = test)
summary(exponential.model)
Counts.exponential2 <- exp(predict(exponential.model,list(Group.3=test$Group.3)))
plot(test$Group.3, test$x,pch=16)
lines(test$Group.3, Counts.exponential2,lwd=2, col = "red", xlab = "Time (s)", ylab = "Counts")
constructs = levels(MeanRes$Group.1)
CorMat = data.frame(matrix(ncol=4, nrow = 11))
colnames(CorMat) <- c("Construct", "NoStim_Act", "NoStim_Sham", "Act_Sham")
CorMat2 = data.frame(matrix(ncol=2, nrow = 11))
colnames(CorMat2) <- c("Construct", "nonActive_Active")
for (i in 1:length(constructs)){
a = constructs[i]
myMeanRes = MeanRes[MeanRes$Group.1 == a & MeanRes$Group.3 < 1410 & MeanRes$Group.3,]
myMedianRes = MedianRes[MedianRes$Group.1 == a & MedianRes$Group.3 < 1410 & MeanRes$Group.3,]
nonActive = myMeanRes[myMeanRes$Group.2 != "No Active",]
MeanNonActive = aggregate(as.numeric(nonActive$x), by = list(nonActive$Group.3), FUN = mean)
CorMat$Construct[i] = a
CorMat$NoStim_Act[i] = cor(myMeanRes$x[myMeanRes$Group.2 == "No Stimulus"], myMeanRes$x[myMeanRes$Group.2 == "Active"])
CorMat$NoStim_Sham[i] = cor(myMeanRes$x[myMeanRes$Group.2 == "No Stimulus"], myMeanRes$x[myMeanRes$Group.2 == "Sham"])
CorMat$Act_Sham[i] = cor(myMeanRes$x[myMeanRes$Group.2 == "Active"], myMeanRes$x[myMeanRes$Group.2 == "Sham"])
CorMat2$Construct[i] = a
CorMat2$nonActive_Active[i] = cor(myMeanRes$x[myMeanRes$Group.2 == "Active"], MeanNonActive$x)
}
