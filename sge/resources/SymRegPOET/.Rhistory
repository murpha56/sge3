EPG = MeanRes[MeanRes$Group.1 == "EPG-IRES-GCaMP6m",]
M.E = MeanRes[MeanRes$Group.1 == "EPG-IRES-GCaMP6m (M.e. 3F)",]
MFF = MeanRes[MeanRes$Group.1 == "Halo-N-EPG3FK-MFF",]
S.M = MeanRes[MeanRes$Group.1 == "EPG-IRES-GCaMP6m (S.m. 3F)",]
BNCR = MeanRes[MeanRes$Group.1 == "Halo-N-BNCR",]
I.P = MeanRes[MeanRes$Group.1 == "EPG-IRES-GCaMP6m (I.p. 3F)",]
FFW = MeanRes[MeanRes$Group.1 == "Halo-N-EPG3FK-FFW",]
FWF = MeanRes[MeanRes$Group.1 == "Halo-N-EPG-3FK-FWF",]
MWW = MeanRes[MeanRes$Group.1 == "Halo-N-EPG3FK-MWW",]
CD59 = MeanRes[MeanRes$Group.1 == "Halo-N-CD59",]
